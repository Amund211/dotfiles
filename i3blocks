# My i3blocks config file
#
# This is intended for use with blocklets from
# https://github.com/vivien/i3blocks-contrib
#
# List of valid properties:
#
# align
# color
# command
# full_text
# instance
# interval
# label
# min_width
# name
# separator
# separator_block_width
# short_text
# signal
# urgent

# Global properties
#
# env-var for location of the repo?
# env-vars for the settings in this file?
command=$HOME/git/i3blocks-contrib/$BLOCK_NAME/$BLOCK_NAME
separator_block_width=15
markup=none

# Week number
[week]
label=WEEK 
command=date '+%V'
interval=once
interval=1

# Claude Code session status: orange dot = waiting on you, green = done.
# Dots are tagged with the workspace number; green auto-clears when you focus it.
[claude_status]
command=$HOME/.dotfiles/scripts/claude-status-block.sh
markup=pango
interval=1
signal=12

# Volume indicator

[volume]
label=♪ 
#label=VOL
interval=once
signal=10
STEP=5%

# Memory usage
[memory]
label=MEM 
separator=false
interval=30

[memory]
label=SWP 
instance=swap
interval=30

# Disk usage
[disk]
label=/ 
DIR=/
interval=once

# Network interface monitoring, on the interface of the default route
[iface]
color=#00FF00
interval=once
separator=false

# All interfaces except lo. INTERFACE is inverted in bandwidth2: it excludes the interface.
[bandwidth2]
REFRESH_TIME=1
markup=pango
interval=persist

# CPU usage
[cpu_usage2]
LABEL=CPU 
REFRESH_TIME=1
min_width=CPU 100.00%
separator=false
markup=pango
interval=persist

# GPU usage
[gpu-load]
command=$HOME/.dotfiles/scripts/gpu-load.sh
label=GPU 
interval=10
separator=false
min_width=100% 100%

[load_average]
label=LOAD 
interval=10

# Temperature
[temperature]
# CPU chip on AMD or Intel; without it the first chip (here the NVMe SSD) is used
SENSOR_CHIP=k10temp-* coretemp-*
label=TEMP 
interval=10

# Battery indicator
[battery]
label=⚡ 
interval=30

# Uptime
[uptime]
command=uptime -p | tr ',' ' ' | cut -f1-3 -d' '
interval=60

# Date Time
[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=1
